{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {"analytics": false},
  "projects": {
    "workspace": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "architect": {
        "build": {"builder": "@angular/build:application", "options": {
          "browser": "src/main.ts", "index": "src/index.html", "tsConfig": "tsconfig.json",
          "outputPath": "dist/workspace", "styles": ["src/styles.css"]
        }},
        "serve": {"builder": "@angular/build:dev-server", "options": {
          "buildTarget": "workspace:build", "host": "127.0.0.1", "proxyConfig": "proxy.cjs"
        }}
      }
    }
  }
}
