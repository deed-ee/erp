{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "erp4us requirement slice v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "title",
    "description",
    "rationale",
    "type",
    "domain",
    "capability",
    "industries",
    "actors",
    "priority",
    "status",
    "dependencies",
    "milestone",
    "acceptance",
    "scenarios",
    "decisions",
    "refines",
    "issues",
    "prs",
    "contracts",
    "tests",
    "evidence",
    "questions",
    "revision"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[A-Z]{2,4}-[0-9]{3}$"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "rationale": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "type": {
      "enum": [
        "business",
        "functional",
        "non-functional"
      ]
    },
    "domain": {
      "type": "string",
      "pattern": "^[A-Z]{2,4}$"
    },
    "capability": {
      "type": "string",
      "pattern": "^[A-Z]{2,4}\\.[0-9]{2}$"
    },
    "industries": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      },
      "uniqueItems": true,
      "minItems": 1
    },
    "actors": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      },
      "uniqueItems": true,
      "minItems": 1
    },
    "priority": {
      "enum": [
        "P0",
        "P1",
        "P2",
        "P3"
      ]
    },
    "status": {
      "enum": [
        "proposed",
        "needs-analysis",
        "in-review",
        "approved",
        "in-implementation",
        "implemented",
        "verified",
        "deferred",
        "rejected",
        "superseded"
      ]
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Z]{2,4}-[0-9]{3}$"
      },
      "uniqueItems": true,
      "minItems": 0
    },
    "milestone": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "acceptance": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      },
      "uniqueItems": true,
      "minItems": 1
    },
    "scenarios": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      },
      "uniqueItems": true,
      "minItems": 1
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      },
      "uniqueItems": true,
      "minItems": 0
    },
    "refines": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^BD-(00[1-9]|01[0-9]|02[0-4])$"
      },
      "uniqueItems": true,
      "minItems": 0
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 1
      },
      "uniqueItems": true,
      "minItems": 0
    },
    "prs": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 1
      },
      "uniqueItems": true,
      "minItems": 0
    },
    "contracts": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      },
      "uniqueItems": true,
      "minItems": 0
    },
    "tests": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      },
      "uniqueItems": true,
      "minItems": 0
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^https://"
      },
      "uniqueItems": true,
      "minItems": 0
    },
    "questions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      },
      "uniqueItems": true,
      "minItems": 0
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "disposition": {
      "type": "string",
      "minLength": 1
    },
    "supersededBy": {
      "type": "string",
      "pattern": "^[A-Z]{2,4}-[0-9]{3}$"
    },
    "reviewedOn": {
      "type": "string",
      "format": "date"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "verified"
          }
        }
      },
      "then": {
        "properties": {
          "evidence": {
            "minItems": 1
          },
          "tests": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "approved",
              "deferred",
              "rejected",
              "superseded"
            ]
          }
        }
      },
      "then": {
        "required": [
          "disposition"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "superseded"
          }
        }
      },
      "then": {
        "required": [
          "supersededBy"
        ]
      }
    }
  ]
}
