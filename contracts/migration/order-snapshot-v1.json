{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Order snapshot for offline ERP migration rehearsal, version 1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "snapshotRole", "tenantId", "organizationId", "sourceSystem", "checkpoint", "orders"],
  "properties": {
    "schemaVersion": {"type": "integer", "const": 1},
    "snapshotRole": {"enum": ["legacy", "candidate"]},
    "tenantId": {"$ref": "#/$defs/scopeId"},
    "organizationId": {"$ref": "#/$defs/scopeId"},
    "sourceSystem": {"$ref": "#/$defs/reference"},
    "checkpoint": {"$ref": "#/$defs/reference"},
    "orders": {
      "type": "array",
      "items": {"$ref": "#/$defs/order"}
    }
  },
  "$defs": {
    "scopeId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}(?![\\s\\S])",
      "not": {"const": "00000000-0000-0000-0000-000000000000"}
    },
    "reference": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}(?![\\s\\S])"},
    "decimal": {"type": "string", "pattern": "^(0|[1-9][0-9]{0,17})(\\.[0-9]{1,9})?(?![\\s\\S])"},
    "line": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lineRef", "articleRef", "unit", "remainingQuantity"],
      "properties": {
        "lineRef": {"$ref": "#/$defs/reference"},
        "articleRef": {"$ref": "#/$defs/reference"},
        "unit": {"type": "string", "pattern": "^[A-Z][A-Z0-9-]{0,15}(?![\\s\\S])"},
        "remainingQuantity": {"$ref": "#/$defs/decimal"}
      }
    },
    "order": {
      "type": "object",
      "additionalProperties": false,
      "required": ["orderRef", "status", "totalAmount", "currency", "lines"],
      "properties": {
        "orderRef": {"$ref": "#/$defs/reference"},
        "status": {"enum": ["open", "cancelled", "fulfilled"]},
        "totalAmount": {"$ref": "#/$defs/decimal"},
        "currency": {"type": "string", "pattern": "^[A-Z]{3}(?![\\s\\S])"},
        "lines": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/line"}}
      }
    }
  }
}
