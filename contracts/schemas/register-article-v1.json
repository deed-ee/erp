{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Register Article v1",
  "type": "object",
  "required": ["sku", "name"],
  "additionalProperties": false,
  "properties": {
    "sku": { "type": "string", "minLength": 1, "maxLength": 32, "not": { "pattern": "[^A-Z0-9-]" } },
    "name": { "type": "string", "minLength": 1, "maxLength": 120, "pattern": "[^\\u0020\\u0085\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000]", "not": { "pattern": "[\\u0000-\\u001f\\u007f]" } }
  }
}
