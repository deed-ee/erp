{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Register unit command v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["code"],
  "properties": {
    "code": { "type": "string", "minLength": 1, "maxLength": 16, "pattern": "^[A-Z][A-Z0-9-]*$", "not": { "pattern": "[^A-Z0-9-]" } }
  }
}
