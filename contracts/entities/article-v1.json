{
  "specVersion": "1.0-draft",
  "entity": "master-data.article",
  "schema": "../schemas/article-v1.json",
  "labelKey": "masterData.article.title",
  "operations": {
    "register": {
      "kind": "command",
      "operationId": "registerArticle",
      "permission": "master-data.article.register",
      "labelKey": "masterData.article.register"
    },
    "get": {
      "kind": "query",
      "operationId": "getArticle",
      "permission": "master-data.article.read",
      "labelKey": "masterData.article.read"
    },
    "findBySku": {
      "kind": "query",
      "operationId": "findArticleBySku",
      "permission": "master-data.article.read",
      "labelKey": "masterData.article.findBySku",
      "discovery": {
        "authorizationOperationId": "discoverArticleSkuLookup",
        "parameter": "sku",
        "phrases": {
          "en": ["find article with sku", "show me the article with sku", "find product by sku", "show product"],
          "de": ["finde artikel mit sku", "zeige mir den artikel mit sku", "finde produkt nach sku", "zeige produkt"]
        }
      }
    },
    "findByName": {
      "kind": "query",
      "operationId": "findArticlesByName",
      "permission": "master-data.article.read",
      "labelKey": "masterData.article.findByName",
      "discovery": {
        "authorizationOperationId": "discoverArticleNameLookup",
        "parameter": "name",
        "phrases": {
          "en": ["find article named", "show articles named"],
          "de": ["finde artikel mit bezeichnung", "zeige artikel namens"]
        }
      }
    }
  }
}
